# Optional large static assets.
# Values must be full HTTPS URLs to PMTiles files hosted on a Range-capable origin.
# VITE_TERRAIN_PMTILES_URL expects 256px Mapbox-encoded Terrain-RGB/raster-dem PMTiles.
VITE_TERRAIN_PMTILES_URL=
# VITE_BASEMAP_PMTILES_URL expects raster PMTiles; vector PMTiles need explicit source-layer styling.
VITE_BASEMAP_PMTILES_URL=

# V2 immersive scene media may be referenced by absolute HTTPS URLs inside
# public/data/immersive/scenes/*.json. Large media should live on a CORS-enabled
# static origin; PMTiles origins must also support HTTP Range requests.

# Optional verified Roman-road GeoJSON (for example a locally hosted DARE/AWMC derivative).
# Prefer a same-origin or CORS-enabled HTTPS URL. Roads are context layers, not proof of a person's exact route.
VITE_ROMAN_ROADS_GEOJSON_URL=

# GitHub Pages deployment can supply the same three values as repository Variables
# (Settings -> Secrets and variables -> Actions -> Variables). Leave them unset to
# deploy the lightweight bundled fallback. External PMTiles origins must be HTTPS,
# CORS-readable from the Pages origin, and support HTTP byte-range requests.
# If VITE_BASEMAP_PMTILES_URL is set, attribution is mandatory. Use a truthful
# source/license string, or "Public domain; no attribution required" where applicable.
VITE_BASEMAP_ATTRIBUTION=
# Road attribution is source-aware. Supported registry ids in alpha.11:
# dare-roman-roads | awmc-antiquity-alacarte
VITE_ROMAN_ROADS_SOURCE_ID=dare-roman-roads
