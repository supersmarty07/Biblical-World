    "s3Bucket": "copernicus-dem-30m",
    "resolutionMeters": 30,
    "horizontalCrs": "EPSG:4326",
    "verticalDatum": "EGM2008",
    "surfaceType": "DSM",
    "evidenceClass": "real-terrain",
    "temporalMeaning": "modern physical terrain base",
    "verificationPolicy": "Every object must pass a live HTTP byte-range GET and TIFF signature check in GitHub Actions before download or build."
